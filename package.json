{
  "name": "encavale-server",
  "version": "1.8.1",
  "description": "Serveur multijoueur du jeu En Cavale (à héberger soi-même, comme un serveur Minecraft)",
  "type": "module",
  "main": "src/main.ts",
  "bin": {
    "encavale-server": "src/main.ts"
  },
  "scripts": {
    "start": "node src/main.ts",
    "embed": "node scripts/embed-public.ts",
    "build": "node scripts/embed-public.ts && node scripts/build.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p ."
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  }
}
